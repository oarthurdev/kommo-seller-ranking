modules = ["nodejs-20", "web"]
run = "npm run dev"

[nix]
channel = "stable-25_05"
packages = ["openssh"]

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 5174
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[workflows]
runButton = "Development"

[[workflows.workflow]]
name = "Development"
author = 45793973
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "tsx server/index.ts"
